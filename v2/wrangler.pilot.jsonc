{
  "name": "family-rewards-pilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-rewards-pilot-db",
      "database_id": "eb9d417c-3269-465b-94cd-af8a296bde1e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 1 * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "INSTANCE_ID": "family-pilot",
    "INSTANCE_ORIGIN": "https://family-rewards-pilot.akedem83.workers.dev"
  }
}
