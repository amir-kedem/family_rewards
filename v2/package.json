{
  "name": "family-rewards-v2",
  "version": "2.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:reset": "node scripts/local-setup.mjs --reset",
    "deploy": "npm run build && wrangler deploy",
    "credentials": "node scripts/hash-password.mjs",
    "build": "tsc && vite build",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --local --config wrangler.local.jsonc"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  }
}
