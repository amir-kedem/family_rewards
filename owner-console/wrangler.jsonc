{
  "name": "family-rewards-owner",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-04",
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "HOUSEHOLDS", "class_name": "Households"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Households"]}],
  "vars": {"PROVISIONING_ENABLED": "false", "MAX_DATABASES": "10", "MAX_HOUSEHOLDS": "8"}
}
